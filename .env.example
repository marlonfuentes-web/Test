# ============================================================
# pump.fun Sniper — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── Wallet ───────────────────────────────────────────────────
# Your Solana wallet private key (Base58 encoded)
# WARNING: Keep this secret! Never commit your .env file
PRIVATE_KEY=your_base58_private_key_here

# ── RPC Endpoints ────────────────────────────────────────────
# Recommended: Helius, QuickNode, or Triton for low latency
# Example Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com

# ── gRPC (Optional — enables ~50ms faster token detection) ───
# Requires Yellowstone-compatible endpoint (Helius/Triton)
# Example Helius gRPC: https://docs.helius.dev/solana-rpc-nodes/grpc-streaming
GRPC_ENDPOINT=
GRPC_TOKEN=

# ── Jito Bundle Engine ───────────────────────────────────────
# Block engine endpoint — pick closest region:
#   mainnet.block-engine.jito.wtf:443
#   ny.mainnet.block-engine.jito.wtf:443
#   amsterdam.mainnet.block-engine.jito.wtf:443
#   frankfurt.mainnet.block-engine.jito.wtf:443
#   tokyo.mainnet.block-engine.jito.wtf:443
JITO_BLOCK_ENGINE=mainnet.block-engine.jito.wtf:443

# Tip percentile — higher = more likely to land in competitive blocks
# Options: 25 | 50 | 75 | 95
JITO_TIP_PERCENTILE=75

# ── Trading Parameters ───────────────────────────────────────
# SOL amount to spend per snipe
BUY_AMOUNT_SOL=0.01

# Slippage tolerance in basis points (100 = 1%, 500 = 5%)
SLIPPAGE_BPS=500

# Priority fee multiplier above the 75th percentile market rate
PRIORITY_FEE_MULTIPLIER=1.5

# Maximum number of concurrent open positions
MAX_POSITIONS=10

# ── Auto-Sell Strategy ───────────────────────────────────────
# Take profit: sell when current value reaches X times entry cost
# e.g. 3.0 = sell at 3x (200% profit)
TAKE_PROFIT_MULTIPLIER=3.0

# Stop loss: sell when current value drops to X times entry cost
# e.g. 0.5 = sell when down 50%
STOP_LOSS_MULTIPLIER=0.5

# Trailing stop: sell when price drops X% from its peak
# e.g. 20 = sell if price falls 20% from peak (set to 0 to disable)
TRAILING_STOP_PCT=0

# Force sell after this many milliseconds regardless of price
MAX_HOLD_DURATION_MS=600000

# Portion of position to sell on TP/SL (10000 = 100%)
SELL_PORTION_BPS=10000

# ── Token Filters ────────────────────────────────────────────
# Minimum initial bonding curve liquidity (SOL)
MIN_INITIAL_LIQUIDITY_SOL=1

# Maximum initial bonding curve liquidity (SOL)
# Tokens near 85 SOL are close to Raydium migration — risky
MAX_INITIAL_LIQUIDITY_SOL=85

# Require token metadata to have at least one social link (Twitter/Telegram/Website)
REQUIRE_SOCIAL_LINKS=false

# Comma-separated regex patterns to BLOCK token names (case-insensitive)
# e.g. BLOCKED_NAME_PATTERNS=test,demo,sample
BLOCKED_NAME_PATTERNS=

# Comma-separated creator wallet addresses to block (known ruggers)
BLOCKED_CREATORS=

# ── Monitor Mode ─────────────────────────────────────────────
# "grpc"      — Use Yellowstone gRPC (fastest, requires GRPC_ENDPOINT)
# "websocket" — Use WebSocket logsSubscribe (works with any RPC)
MONITOR_MODE=websocket

# ── Dry Run ──────────────────────────────────────────────────
# Set to "true" to detect tokens and log buy decisions WITHOUT sending transactions
DRY_RUN=false

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
